---
/**
 * The section rail. A fixed vertical strip of section icons, always visible,
 * so the reader can jump between the nine parts of the wiki without scrolling
 * the tree. The active section is derived from the URL prefix.
 */
const path = Astro.url.pathname;

const sections = [
  {
    key: 'start',
    label: 'Start here',
    href: '/start/what-it-is/',
    d: 'M12 3l2.4 5.6L20 10l-4.4 3.3L16.8 19 12 16l-4.8 3 1.2-5.7L4 10l5.6-1.4z',
  },
  {
    key: 'context',
    label: 'Context',
    href: '/context/problem/',
    d: 'M12 3a9 9 0 100 18 9 9 0 000-18zM3.6 9h16.8M3.6 15h16.8M12 3c2.5 2.4 3.8 5.5 3.8 9S14.5 18.6 12 21c-2.5-2.4-3.8-5.5-3.8-9S9.5 5.4 12 3z',
  },
  {
    key: 'people',
    label: 'People and permissions',
    href: '/people/tenancy/',
    d: 'M9 11a3.2 3.2 0 100-6.4A3.2 3.2 0 009 11zM3 19.5c0-3 2.7-4.8 6-4.8s6 1.8 6 4.8M16.2 11.2a2.8 2.8 0 100-5.6M17 14.9c2.4.4 4 2 4 4.2',
  },
  {
    key: 'flows',
    label: 'Flows',
    href: '/flows/journey/',
    d: 'M6 4.5v6.8a3 3 0 003 3h6a3 3 0 013 3v2.2M6 4.5a2 2 0 110 4 2 2 0 010-4zM18 17.5a2 2 0 110 4 2 2 0 010-4zM13.5 11.3h2a3 3 0 003-3V6.5M18 2.5a2 2 0 110 4 2 2 0 010-4z',
  },
  {
    key: 'screens',
    label: 'The screens',
    href: '/screens/overview/',
    d: 'M3.5 5.5h17v13h-17zM3.5 9.5h17M8 9.5v9',
  },
  {
    key: 'model',
    label: 'How the numbers work',
    href: '/model/engines/',
    d: 'M3.5 18.5l4.2-6 3.4 3.2 3.2-6 2.6 3.4 3.6-5.6M3.5 3.5v17h17',
  },
  {
    key: 'interfaces',
    label: 'Interfaces',
    href: '/interfaces/principles/',
    d: 'M8.5 7.5L4 12l4.5 4.5M15.5 7.5L20 12l-4.5 4.5M13.6 4.2l-3.2 15.6',
  },
  {
    key: 'architecture',
    label: 'Architecture',
    href: '/architecture/system-map/',
    d: 'M12 2.8l8.5 4.4-8.5 4.4-8.5-4.4zM3.5 12.2l8.5 4.4 8.5-4.4M3.5 16.6l8.5 4.4 8.5-4.4',
  },
  {
    key: 'operations',
    label: 'Operations',
    href: '/operations/onboarding/',
    d: 'M12 15.2a3.2 3.2 0 100-6.4 3.2 3.2 0 000 6.4zM19.6 14.4l1.7 1a8.6 8.6 0 000-2.8l-1.7 1a7.7 7.7 0 010 .8zM12 3.2v2M12 18.8v2M5.2 7.2l1.7 1M17.1 15.8l1.7 1M5.2 16.8l1.7-1M17.1 8.2l1.7-1',
  },
  {
    key: 'decisions',
    label: 'Working agreements',
    href: '/decisions/record/',
    d: 'M5 4.5h14v15H5zM8.6 11.4l2.2 2.2 4.6-4.6',
  },
];

const active = sections.find((s) => path.startsWith(`/${s.key}/`))?.key ?? 'home';
---

<nav class="rail" aria-label="Wiki sections">
  <a
    class:list={['rail__home', { 'is-active': active === 'home' }]}
    href="/"
    aria-label="Wiki home"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"
      ><path
        d="M4 11.2L12 4.5l8 6.7V20h-5.6v-5.1H9.6V20H4z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linejoin="round"
      ></path></svg
    >
    <span class="rail__tip">Home</span>
  </a>

  <span class="rail__rule"></span>

  {
    sections.map((s) => (
      <a
        class:list={['rail__item', { 'is-active': active === s.key }]}
        href={s.href}
        aria-label={s.label}
        aria-current={active === s.key ? 'true' : undefined}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d={s.d}
            fill="none"
            stroke="currentColor"
            stroke-width="1.55"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
        <span class="rail__tip">{s.label}</span>
      </a>
    ))
  }
</nav>
