---
/**
 * <Flow> draws a diagram from data: nodes placed on a grid plus the edges
 * between them. Edge routing is automatic from the sides you name, so a
 * diagram stays editable by anyone who can edit a list.
 *
 *   nodes: { id, x, y, w, h, title, sub?, eyebrow?, kind?, align? }
 *   lanes: { x, y, w, h, label? }          (background groupings)
 *   edges: { from: 'id.r', to: 'id.l', label?, kind?, dx?, dy? }
 *   notes: { x, y, text, align? }          (free text)
 *
 * kind: default | accent | ok | warn | stop | violet | ghost
 * edge kind: default | accent | dash | stop | ok
 */
interface Node {
  id: string;
  x: number;
  y: number;
  w: number;
  h: number;
  title: string;
  sub?: string | string[];
  eyebrow?: string;
  kind?: string;
  align?: 'left' | 'center';
}
interface Lane { x: number; y: number; w: number; h: number; label?: string }
interface Edge { from: string; to: string; label?: string; kind?: string; dx?: number; dy?: number }
interface Note { x: number; y: number; text: string; align?: 'start' | 'middle' | 'end'; kind?: string }

interface Props {
  width: number;
  height: number;
  nodes: Node[];
  edges?: Edge[];
  lanes?: Lane[];
  notes?: Note[];
  caption?: string;
  title?: string;
  uid?: string;
}

const { width, height, nodes, edges = [], lanes = [], notes = [], caption, title, uid = 'f' } = Astro.props as Props;

const byId = new Map(nodes.map((n) => [n.id, n]));

function anchor(ref: string) {
  const dot = ref.indexOf('.');
  const id = ref.slice(0, dot);
  const side = ref.slice(dot + 1);
  const n = byId.get(id);
  if (!n) throw new Error(`Flow: unknown node "${id}"`);
  // optional position along the side, e.g. "a.r:0.3"
  const [s, frac] = side.split(':');
  const f = frac === undefined ? 0.5 : parseFloat(frac);
  switch (s) {
    case 't': return { x: n.x + n.w * f, y: n.y, d: 't' };
    case 'b': return { x: n.x + n.w * f, y: n.y + n.h, d: 'b' };
    case 'l': return { x: n.x, y: n.y + n.h * f, d: 'l' };
    default: return { x: n.x + n.w, y: n.y + n.h * f, d: 'r' };
  }
}

function route(e: Edge) {
  const a = anchor(e.from);
  const b = anchor(e.to);
  const pts: [number, number][] = [[a.x, a.y]];
  const k = a.d + b.d;
  const out = 22;
  if (k === 'rl' || k === 'lr') {
    if (Math.abs(a.y - b.y) < 0.5) pts.push([b.x, b.y]);
    else {
      const mx = (a.x + b.x) / 2 + (e.dx ?? 0);
      pts.push([mx, a.y], [mx, b.y], [b.x, b.y]);
    }
  } else if (k === 'bt' || k === 'tb') {
    if (Math.abs(a.x - b.x) < 0.5) pts.push([b.x, b.y]);
    else {
      const my = (a.y + b.y) / 2 + (e.dy ?? 0);
      pts.push([a.x, my], [b.x, my], [b.x, b.y]);
    }
  } else if (k === 'rt' || k === 'lt') {
    pts.push([b.x, a.y], [b.x, b.y]);
  } else if (k === 'rb' || k === 'lb') {
    pts.push([b.x, a.y], [b.x, b.y]);
  } else if (k === 'bl' || k === 'br') {
    pts.push([a.x, b.y], [b.x, b.y]);
  } else if (k === 'tl' || k === 'tr') {
    pts.push([a.x, b.y], [b.x, b.y]);
  } else if (k === 'rr') {
    const mx = Math.max(a.x, b.x) + out + (e.dx ?? 0);
    pts.push([mx, a.y], [mx, b.y], [b.x, b.y]);
  } else if (k === 'll') {
    const mx = Math.min(a.x, b.x) - out + (e.dx ?? 0);
    pts.push([mx, a.y], [mx, b.y], [b.x, b.y]);
  } else if (k === 'bb') {
    const my = Math.max(a.y, b.y) + out + (e.dy ?? 0);
    pts.push([a.x, my], [b.x, my], [b.x, b.y]);
  } else if (k === 'tt') {
    const my = Math.min(a.y, b.y) - out + (e.dy ?? 0);
    pts.push([a.x, my], [b.x, my], [b.x, b.y]);
  } else {
    pts.push([b.x, b.y]);
  }
  const d = pts.map((p, i) => `${i ? 'L' : 'M'}${p[0]} ${p[1]}`).join(' ');
  // label sits on the longest segment's midpoint
  let best = 0, lx = pts[0][0], ly = pts[0][1];
  for (let i = 1; i < pts.length; i++) {
    const len = Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]);
    if (len > best) { best = len; lx = (pts[i][0] + pts[i - 1][0]) / 2; ly = (pts[i][1] + pts[i - 1][1]) / 2; }
  }
  return { d, lx, ly };
}

function lines(n: Node) {
  const sub = n.sub === undefined ? [] : Array.isArray(n.sub) ? n.sub : n.sub.split('\n');
  return sub;
}

function layout(n: Node) {
  const sub = lines(n);
  const rows = (n.eyebrow ? 1 : 0) + 1 + sub.length;
  const lh = 17;
  const total = (n.eyebrow ? 15 : 0) + 18 + sub.length * lh;
  let y = n.y + (n.h - total) / 2 + 9;
  const out: { cls: string; text: string; y: number }[] = [];
  if (n.eyebrow) { out.push({ cls: 'd-k', text: n.eyebrow, y }); y += 15; }
  out.push({ cls: 'd-t', text: n.title, y: y + (n.eyebrow ? 2 : 0) }); y += 18 + (n.eyebrow ? 2 : 0);
  for (const s of sub) { out.push({ cls: 'd-s', text: s, y: y }); y += lh; }
  return out;
}

const edgeKinds: Record<string, string> = {
  default: 'd-line',
  accent: 'd-line--accent',
  dash: 'd-line--dash',
  stop: 'd-line--stop',
  ok: 'd-line--ok',
};
const markFill: Record<string, string> = {
  default: 'var(--ln-2)',
  accent: 'var(--brand)',
  dash: 'var(--ln-2)',
  stop: 'var(--stop)',
  ok: 'var(--ok)',
};
const kindsUsed = [...new Set(['default', ...edges.map((e) => e.kind ?? 'default')])];
---

<div class="diagram not-content">
  <svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label={title ?? caption ?? 'Diagram'}>
    <defs>
      {kindsUsed.map((k) => (
        <marker id={`${uid}-ah-${k}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M1 1.5 L9 5 L1 8.5 Z" style={`fill:${markFill[k] ?? markFill.default}`} />
        </marker>
      ))}
    </defs>

    {lanes.map((l) => (
      <g>
        <rect class="d-lane" x={l.x} y={l.y} width={l.w} height={l.h} rx="14" />
        {l.label && <text class="d-k" x={l.x + 16} y={l.y + 17}>{l.label}</text>}
      </g>
    ))}

    {edges.map((e) => {
      const r = route(e);
      const k = e.kind ?? 'default';
      return (
        <g>
          <path class={edgeKinds[k] ?? 'd-line'} d={r.d} marker-end={`url(#${uid}-ah-${k})`} />
          {e.label && (
            <g>
              <rect x={r.lx - e.label.length * 2.9 - 6} y={r.ly - 9} width={e.label.length * 5.8 + 12} height="18" rx="9" style="fill:var(--s-card);stroke:var(--ln);stroke-width:1" />
              <text class="d-s" x={r.lx} y={r.ly + 0.5} text-anchor="middle" style="fill:var(--fg-3)">{e.label}</text>
            </g>
          )}
        </g>
      );
    })}

    {nodes.map((n) => {
      const kind = n.kind && n.kind !== 'default' ? ` d-box--${n.kind}` : '';
      const ls = layout(n);
      const center = n.align === 'center';
      const tx = center ? n.x + n.w / 2 : n.x + 15;
      return (
        <g>
          <rect class={`d-box${kind}`} x={n.x} y={n.y} width={n.w} height={n.h} rx="10" />
          {ls.map((l) => (
            <text class={l.cls} x={tx} y={l.y} text-anchor={center ? 'middle' : 'start'} style={l.cls === 'd-k' && n.kind === 'violet' ? 'fill:var(--violet)' : undefined}>{l.text}</text>
          ))}
        </g>
      );
    })}

    {notes.map((t) => (
      <text class="d-s" x={t.x} y={t.y} text-anchor={t.align ?? 'start'}>{t.text}</text>
    ))}
  </svg>
  {caption && <p class="diagram__cap" set:html={caption} />}
</div>
